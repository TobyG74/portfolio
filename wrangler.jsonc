{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tobz-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Public (non-secret) variables. The Cloudflare KV credentials below are
  // SECRETS — do not put real values here. Set them with:
  //   wrangler secret put CLOUDFLARE_ACCOUNT_ID
  //   wrangler secret put CLOUDFLARE_KV_NAMESPACE_ID
  //   wrangler secret put CLOUDFLARE_API_TOKEN
  "vars": {
    "VISITOR_COUNTER_KEY": "site_visitors"
  }
  // Optional: use a native KV binding instead of the REST API.
  // "kv_namespaces": [{ "binding": "KV", "id": "<your-namespace-id>" }]
}
