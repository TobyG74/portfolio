# --- Cloudflare KV (visitor counter + guestbook) ---
# Create a KV namespace in the Cloudflare dashboard, then a scoped API token
# with the "Workers KV Storage:Edit" permission.
# If these are empty the app falls back to an in-memory store (dev only).

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Key used to store the visitor count (optional, has a sensible default)
VISITOR_COUNTER_KEY=site_visitors